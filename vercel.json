{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "buildCommand": "npm ci --include=dev --no-audit --no-fund && npm run build:ui",
  "functions": {
    "app.py": {
      "includeFiles": "templates/**",
      "excludeFiles": "{node_modules/**,src/**,test_*.py,prepare_*.py,*.ps1,*.cmd}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "no-referrer"},
        {"key": "Content-Security-Policy", "value": "default-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; script-src 'self'; connect-src 'self'; img-src 'self' data:; object-src 'none'; frame-ancestors 'none'; base-uri 'none'"}
      ]
    }
  ]
}
